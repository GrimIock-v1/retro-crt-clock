# Example: Aldergrove/Langley area. Replace if desired.
LATITUDE=49.058
LONGITUDE=-122.470
TIMEZONE=America/Vancouver

# Comma-separated private/public ICS URLs. Leave blank for no calendar.
# Never commit your real private Google/Apple ICS URL.
CALENDAR_URLS=

# Background workers, not /api/status, perform these slow upstream requests.
REFRESH_SECONDS=180
RETRY_SECONDS=60
STALE_AFTER_SECONDS=900
STATE_FILE=/data/last_status.json
